# ─── Required: DeepSeek AI ────────────────────────────────────────────────────
# Powers AI-generated security report summaries and PentAGI analysis.
# Get your key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# ─── Required: Authentication ─────────────────────────────────────────────────
# Secret used to sign JWT session tokens. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# ─── Required for payments: Stripe ────────────────────────────────────────────
# Your Stripe secret key (sk_live_... for production, sk_test_... for testing).
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"

# Stripe webhook signing secret — from the Stripe dashboard webhook settings.
# Used to verify that webhook events genuinely originate from Stripe.
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"

# Stripe Price IDs for each credit pack — create these in your Stripe dashboard.
# Each should be a one-time payment price (not subscription).
STRIPE_PRICE_SINGLE="price_XXXXXXXXXXXXXXXXXXXXXXXX"  # 1 credit  — $29
STRIPE_PRICE_PACK5="price_XXXXXXXXXXXXXXXXXXXXXXXX"   # 5 credits — $99
STRIPE_PRICE_PACK20="price_XXXXXXXXXXXXXXXXXXXXXXXX"  # 20 credits — $299

# ─── Deployment ───────────────────────────────────────────────────────────────
# The public URL of your deployment. Used for Stripe success/cancel redirects.
# In development this defaults to http://localhost:3000
APP_URL="https://your-deployment-url.com"

# Node environment — set to "production" when deploying
NODE_ENV="production"
