# =============================================================================
# Seclayer environment configuration
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# All variables are optional unless noted; sensible defaults are applied.
# =============================================================================

# --- AI provider (DeepSeek) ----------------------------------------------------
# DEEPSEEK_API_KEY: Enables AI-generated pentest report summaries via DeepSeek's
# OpenAI-compatible API. When unset or left as the placeholder, the server falls
# back to a deterministic local summary (the app still works fully without it).
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"
# OpenAI-compatible base URL for DeepSeek.
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# Models: a higher-quality model for report analysis and a faster one for the
# PentAGI log simulation.
# DEEPSEEK_REPORT_MODEL="deepseek-v4-pro"
# DEEPSEEK_LOG_MODEL="deepseek-v4-flash"
# Per-request timeout for AI calls (milliseconds).
# DEEPSEEK_TIMEOUT_MS="30000"
# Max output tokens per AI call. Default 8000 fits a complete multi-finding
# report; raise only if very large targets truncate mid-report.
# DEEPSEEK_MAX_TOKENS="8000"

# --- Runtime -------------------------------------------------------------------
# NODE_ENV: "development" (default) | "production" | "test".
# NODE_ENV="production"
# HTTP port and bind host (PORT is respected by most PaaS platforms).
# PORT="3000"
# HOST="0.0.0.0"
# Public URL where this app is hosted (used for self-referential links).
APP_URL="MY_APP_URL"

# --- Datastore -----------------------------------------------------------------
# Path to the JSON datastore file (relative paths resolve from the cwd).
# DB_FILE="db.json"
# SEED_DEMO_DATA: seed illustrative demo scans into a fresh datastore. Defaults
# to true in development and false in production, so a real deployment never
# starts with fabricated scan results. Set to "true" to force seeding.
# SEED_DEMO_DATA="false"

# --- Logging -------------------------------------------------------------------
# LOG_LEVEL: debug | info | warn | error (defaults: debug in dev, info in prod).
# LOG_LEVEL="info"
# LOG_JSON: emit line-delimited JSON logs (defaults: true in production).
# LOG_JSON="true"

# --- Security ------------------------------------------------------------------
# Comma-separated CORS allowlist. Empty means same-origin only.
# CORS_ORIGINS="https://app.seclayer.io,https://seclayer.io"
# Maximum request body size accepted by the API.
# BODY_LIMIT="256kb"
# SSRF guard: when false (default in production), the scanner refuses targets
# that resolve to private/loopback/reserved address space. Enable ONLY in
# trusted lab environments.
# SCANNER_ALLOW_PRIVATE_TARGETS="false"

# --- Sessions --------------------------------------------------------------------
# SESSION_SECRET: HMAC key used to sign session cookies. REQUIRED in production
# (the server refuses to start without it); a fixed dev value is used otherwise.
# Generate with: openssl rand -hex 32
SESSION_SECRET="MY_SESSION_SECRET"
# Session lifetime in seconds (default 7 days).
# SESSION_TTL_SECONDS="604800"

# --- Rate limiting -------------------------------------------------------------
# Sliding window length and per-window request caps (general + scan endpoints).
# RATE_LIMIT_WINDOW_MS="60000"
# RATE_LIMIT_MAX="120"
# RATE_LIMIT_SCAN_MAX="10"
