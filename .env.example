# DEEPSEEK_API_KEY: Required for DeepSeek AI report generation.
# When unset, the app gracefully falls back to high-quality local summaries.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# Optional overrides for the DeepSeek API endpoint and model routing.
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL_PRO="deepseek-v4-pro"      # deep security report reasoning
# DEEPSEEK_MODEL_FLASH="deepseek-v4-flash"  # fast PentAGI log narration

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
