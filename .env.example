# =============================================================================
# Seclayer environment configuration
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# All variables are optional unless noted; sensible defaults are applied.
# =============================================================================

# --- AI provider ---------------------------------------------------------------
# GEMINI_API_KEY: Enables AI-generated pentest report summaries. When unset or
# left as the placeholder, the server falls back to a deterministic local
# summary (the app still works fully without it).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Override the Gemini model used for report/log generation.
# GEMINI_MODEL="gemini-3.5-flash"

# --- Runtime -------------------------------------------------------------------
# NODE_ENV: "development" (default) | "production" | "test".
# NODE_ENV="production"
# HTTP port and bind host (PORT is respected by most PaaS platforms).
# PORT="3000"
# HOST="0.0.0.0"
# Public URL where this app is hosted (used for self-referential links).
APP_URL="MY_APP_URL"

# --- Datastore -----------------------------------------------------------------
# Path to the JSON datastore file (relative paths resolve from the cwd).
# DB_FILE="db.json"

# --- Logging -------------------------------------------------------------------
# LOG_LEVEL: debug | info | warn | error (defaults: debug in dev, info in prod).
# LOG_LEVEL="info"
# LOG_JSON: emit line-delimited JSON logs (defaults: true in production).
# LOG_JSON="true"

# --- Security ------------------------------------------------------------------
# Comma-separated CORS allowlist. Empty means same-origin only.
# CORS_ORIGINS="https://app.seclayer.io,https://seclayer.io"
# Maximum request body size accepted by the API.
# BODY_LIMIT="256kb"
# SSRF guard: when false (default in production), the scanner refuses targets
# that resolve to private/loopback/reserved address space. Enable ONLY in
# trusted lab environments.
# SCANNER_ALLOW_PRIVATE_TARGETS="false"

# --- Rate limiting -------------------------------------------------------------
# Sliding window length and per-window request caps (general + scan endpoints).
# RATE_LIMIT_WINDOW_MS="60000"
# RATE_LIMIT_MAX="120"
# RATE_LIMIT_SCAN_MAX="10"
