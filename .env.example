# ─── Required: DeepSeek AI ────────────────────────────────────────────────────
# Powers AI-generated security report summaries and PentAGI analysis.
# Get your key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# ─── Required: Authentication ─────────────────────────────────────────────────
# Secret used to sign JWT session tokens. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# ─── Optional: OAST Blind Vulnerability Detection ─────────────────────────────
# Domain pointing at this deployment's /oast/:token endpoint. When set, PentAGI
# runs out-of-band probes (blind XSS, blind SSRF, blind RCE) that call back here.
# Leave unset to disable OAST probes. Example: oast.yourdomain.com
# OAST_DOMAIN="oast.yourdomain.com"

# ─── Deployment ───────────────────────────────────────────────────────────────
# The public URL of your deployment. Defaults to http://localhost:3000 in development.
APP_URL="https://your-deployment-url.com"

# Node environment — set to "production" when deploying
NODE_ENV="production"
